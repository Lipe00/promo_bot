# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Nunca commite o .env.local.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Use a chave "service_role" (só no servidor; nunca no navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Telegram → @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Opcional, só informativo
TELEGRAM_BOT_USERNAME=
# Texto aleatório e longo; o Telegram devolve esse valor em cada chamada pro webhook
TELEGRAM_WEBHOOK_SECRET=
# Seu chat id. Deixe vazio na primeira vez: mande /start pro bot e ele responde com o número.
TELEGRAM_ALLOWED_CHAT_ID=

# Texto aleatório e longo; protege /api/cron/check e /api/telegram/setup
CRON_SECRET=

# Painel web (login). Gere cada um com: openssl rand -hex 32
# PASSWORD_SALT entra no hash das senhas (trocar invalida as senhas cadastradas).
PASSWORD_SALT=
# SESSION_SECRET assina o cookie de sessão (trocar desloga todo mundo).
SESSION_SECRET=

# Canais do Telegram privados e grupos (opcional; canais públicos funcionam sem isto).
# my.telegram.org → API development tools → crie um app (grátis).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Gerada pelo scripts/telegram-login.ts (você digita o código que chega no Telegram). Equivale a estar logado.
TELEGRAM_USER_SESSION=

# ---------------------------------------------------------------------------
# APIs oficiais (opcionais). Sem elas, a loja é lida pela página ou fica "não suportada".
# ---------------------------------------------------------------------------

# Mercado Livre: https://developers.mercadolivre.com.br/devcenter → Criar aplicação (grátis)
# Sem isso o ML bloqueia o robô ("tráfego suspeito"). Também ativa frete pelo CEP e fim da promoção.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Shopee: https://affiliate.shopee.com.br → Open API (precisa ser afiliado aprovado)
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# AliExpress (opcional; a página de busca já funciona sem chave):
# https://portals.aliexpress.com (afiliado) + https://openservice.aliexpress.com (app)
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# Tempo de trabalho por checagem em ms (padrão 45000; a função da Vercel tem 60s)
# CHECK_BUDGET_MS=45000
