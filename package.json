{
  "name": "promo-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de alertas de preço: busca produtos em lojas brasileiras e avisa no Telegram.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "test:live": "node --experimental-strip-types --no-warnings --test test/live/*.test.ts",
    "calibrate": "node --experimental-strip-types --no-warnings scripts/calibrate.ts",
    "docker:up": "docker compose -f docker/compose.yml --profile mock up -d",
    "docker:e2e": "docker compose -f docker/compose.yml --profile e2e run --rm e2e",
    "docker:real": "docker compose -f docker/compose.yml --profile real up -d",
    "docker:down": "docker compose -f docker/compose.yml --profile mock --profile real down"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cheerio": "^1.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "telegram": "2.26.22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
